{
  "servers": {
    "coverity": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${workspaceFolder}/coverity_mcp_server.py"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "COVERITY_REPORT": "${workspaceFolder}/docs/sample_report/index.html",
        "COVERITY_SRC_ROOT": "${workspaceFolder}/docs",
        "COVERITY_LANGUAGE": "c"
      }
    }
  },
  "inputs": []
}
